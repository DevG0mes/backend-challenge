{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-instance-safe financial wagering processor",
  "license": "UNLICENSED",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "build": "nest build",
    "db:migrate": "bun run src/database/migrate.ts",
    "test": "bun test ./test/unit ./test/integration ./test/e2e ./test/health",
    "test:unit": "bun test ./test/unit",
    "test:integration": "bun test ./test/integration",
    "test:e2e": "bun test ./test/health ./test/e2e",
    "test:concurrency": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-concurrency.ps1",
    "test:load": "bun run ./scripts/load-test.ts",
    "test:report": "bun test ./test/unit ./test/integration ./test/e2e ./test/health --reporter=junit --reporter-outfile=reports/junit.xml"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1152.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.5",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@types/bun": "1.4.3",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "^6"
  }
}
